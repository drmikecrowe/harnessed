    {
      "id": "claim_3d194fcd6eba4ed19a717528e3d0de88",
      "statement": "`harnessed install <stack>` writes a `~/.local/bin/<stack>` shim expanding to `harnessed container-run --stack <stack> \"$@\"`, baking in the absolute path of this `harnessed` binary so it works even when harnessed is not on PATH; the `--stack` flag deliberately precedes `\"$@\"` so a passthrough invocation cannot swallow it.",
      "evidence": [
