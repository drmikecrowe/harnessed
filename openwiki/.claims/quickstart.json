  "claims": [
    {
      "id": "claim_fc24edcd97424bb78f1979de0dd2b292",
      "statement": "The two interactive launch verbs `harnessed container-run` and `harnessed host-run` hand the terminal to an interactive agent session and are therefore for the user, never the agent; `container-run` attaches a shell inside a pod and `host-run` execs the harness directly on the host against the real home and credentials with no pod. To reason about behavior use `harnessed build`, `harnessed test`, `harnessed list`, or read the source instead.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L12-L18",
          "version": "repo-lines-v1:sha256:fa3c3ef9ec70d71650ba7a8668d076e1d4fe645998c6ed0428d85543db2eb9ac:"
        }
      ]
    },
    {
      "id": "claim_d6aa4664435d42d0ba794f72166d29a2",
      "statement": "`container-run` terminates in an `os.execvp` of the container runtime that replaces the harnessed process and hands the TTY to the container (the `--rm` variant instead runs the exec as a child so the pod can be torn down on exit).",
      "evidence": [
        {
          "resource": "repo://src/harnessed/launcher.py#L3843-L3905",
          "version": "repo-lines-v1:sha256:2ce322bc2c976f9badde75050a0122c7ba683e9d4ad883cecb36ad6a966d3bf0:"
        }
      ]
    },
    {
      "id": "claim_50178ffe035d47f5b464ef1f6ab789fd",
      "statement": "`host-run` (`launcher._launch_host`) terminates in an `os.execvpe` that replaces the harnessed process for a clean TTY handoff to the harness on the host; it execs against the real machine with a per-stack config dir, so once it runs harnessed never regains control.",
      "evidence": [
        {
          "resource": "repo://src/harnessed/hosthome.py#L335-L345",
          "version": "repo-lines-v1:sha256:af213b411bda3a938f97dc5226c24a49bf00545e1e8627e8085399ca5a288dbf:"
        },
        {
          "resource": "repo://src/harnessed/launcher.py#L2795-L2804",
