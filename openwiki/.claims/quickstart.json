        }
      ]
    },
    {
      "id": "claim_c83b3f38dc3a45b49fb6dc87d2ecb005",
      "statement": "`harnessed test <stack> <harness>` is a safe, terminating substitute for a launch: it validates the harness, auto-assembles first when the profile is not built or is stale, then delegates to the `harnessed-tools test` (capability) entrypoint in a subprocess with no outer timeout and propagates the child's exit code.",
      "evidence": [
