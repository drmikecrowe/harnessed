    },
    {
      "id": "claim_289a9639b7cb4a0596e0c290f9e30b57",
      "statement": "Dev setup requires `uv sync --extra dev` and putting the checkout's venv on PATH; the CLI runs on the host so edits under `src/harnessed/` take effect immediately without an image rebuild.",
      "evidence": [
