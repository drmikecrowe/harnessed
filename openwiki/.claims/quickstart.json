    {
      "id": "claim_80e9a43d1b9341b38d898d90374efe3a",
      "statement": "harnessed is a host-native Python CLI driving podman directly — no tool container and no daemon socket — whose package owns all assembly and launch logic in `src/harnessed/`.",
