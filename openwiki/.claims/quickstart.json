    {
      "id": "claim_271b8b55f88243cbac9d7a73291a7359",
      "statement": "The git workflow is non-negotiable: no commits to `main`; every change flows through a new worktree, a passing full test suite, and a PR. The checkout is bare + worktrees (`main/` is the canonical checkout), sessions begin and end in `main/`, and gitignored content such as `docs/` exists only in `main/` — so an empty `ls` inside a worktree means ignored there, never missing.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L56-L83",
          "version": "repo-lines-v1:sha256:14bab5d8c786e1d6fcf5783d670fc7669c0fd048eb4954bb07462f5175352da7:"
        }
      ]
    },
    {
      "id": "claim_5be2de1b91224674af5a068570b142d1",
      "statement": "An agent may modify only files in this repository and must not modify the user's home directory unless explicitly asked.",
      "evidence": [
