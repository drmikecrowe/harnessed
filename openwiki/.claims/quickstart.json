    {
      "id": "claim_9257c253f3d3472f88cb38133f2c92cf",
      "statement": "`src/harnessed/backend.py` is the ExecutionBackend contract: six capabilities (materialize config, provision tools, wire MCP, seed auth, wire services, apply isolation) with deliberately backend-owned sequencing — there is no shared driver calling them in a fixed order, because the host backend materializes before provisioning while the container backend provisions before materializing. `provision_tools` and `apply_isolation` are two-phase (FIRST_START/ATTACH and BOUNDARY/EGRESS), and the module imports nothing from launcher.py (enforced by tests/test_module_boundaries.py).",
      "evidence": [
        {
          "resource": "repo://src/harnessed/backend.py#L1-L37",
          "version": "repo-lines-v1:sha256:03fe2fbe0debf7b266ee0856e63fccb57e91edd608ebdc0aae8b15274894c960:"
        },
