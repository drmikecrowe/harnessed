    {
      "id": "claim_85c432c9c4774e15a4a30229c354a0fb",
      "statement": "The supported harnesses are exactly the keys of schema.HARNESS_CONFIG_DIR — claude, omp, opencode, antigravity, codex — and the run verbs reject any other harness name at the CLI boundary via the shared `_require_supported_harness` helper, so the two entry points cannot drift apart.",
      "evidence": [
        {
          "resource": "repo://src/harnessed/launcher.py#L2807-L2814",
          "version": "repo-lines-v1:sha256:7231505f2244f13aa506f260aed768430375e5e0ee6e4fc6c678f6d77d61c04f:"
