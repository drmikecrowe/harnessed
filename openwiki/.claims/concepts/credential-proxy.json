    {
      "id": "claim_3862f9effc1a49d884bd12ecd0d03281",
      "statement": "`_warn_unproxied_secrets` is value-blind by design: it is silent unless the schema opts in via the `@proxy` annotation gate, and it reports names and modes only — values are never read or printed — which is what makes it safe to run on every launch.",
      "evidence": [
        {
          "resource": "repo://src/harnessed/launchenv.py#L348-L366",
          "version": "repo-lines-v1:sha256:a3eddf122a22469fef4ff3bef29ff65cdec4d42b22e791bf79c49aa0ed79b9e7:"
