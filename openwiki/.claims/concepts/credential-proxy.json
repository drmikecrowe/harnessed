    {
      "id": "claim_4d7d34e85797488680b18e96fe8f2461",
      "statement": "`_warn_unproxied_secrets` is a readiness report, not a live fault: today `_varlock_resolve` runs `varlock load`, which returns the real value for every item whatever its proxy mode, so an unrouted item still works; it stops working at the #388 Phase 1 broker cutover, where the failure is an invisible real-looking placeholder that no API accepts, surfacing far away as a 401. The warning wording therefore deliberately states both tenses and must not be tightened to the present until the broker path is the one actually delivering the values.",
      "evidence": [
        {
          "resource": "repo://src/harnessed/launchenv.py#L348-L359",
          "version": "repo-lines-v1:sha256:5b5986ed5c245da365008a9778a7f6cba9d5326664cf5eeb3437442ff20e8790:"
