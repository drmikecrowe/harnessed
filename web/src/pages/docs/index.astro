---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

// The docs landing renders the wiki Home page (not an "all docs" listing) — the sidebar provides
// navigation. Falls back gracefully if Home.md is somehow absent from the synced content.
const docs = await getCollection("docs");
const home = docs.find((d) => d.id === "home");

const rendered = home ? await render(home) : null;
const Content = rendered?.Content;
const headings = rendered?.headings ?? [];
const h1 = headings.find((h) => h.depth === 1);
---

<DocsLayout
  docs={docs}
  currentId={home?.id}
  headings={headings}
  title={h1?.text ?? "Documentation"}
>
  {Content ? <Content /> : <h1>Documentation</h1>}
</DocsLayout>
