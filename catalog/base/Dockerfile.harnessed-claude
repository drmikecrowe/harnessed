# harnessed-claude — the claude harness image.
# FROM harnessed-base (lineage only, §6) + the Claude Code CLI. Build the base first.

FROM harnessed-base:latest

# Install Claude Code globally via the official installer (into ~/.local/bin, already on PATH).
#
# DECISION REVERSED 2026-09-23 by the owner: harnesses track their vendor's latest release; we
# trust the release process. This RUN used to pass a pinned CLAUDE_VERSION (with a fail-closed
# guard on the empty arg — "THE GUARD IS THE PIN") resolved once from the `stable` channel and
# held as unqueryable, because the vendor's only upstream is a download host, not a queryable
# registry: "latest + publish date" can never be resolved against it, so the pin could only move
# by hand and claude was the one harness `harnessed update` could never bump.
#
# The installer's documented interface is `install.sh [stable|latest|VERSION]`; with no argument
# it installs the current stable. We deliberately pass none: the version is conceded in
# catalog/agents/claude/agent.yaml (`unpinnable: CLAUDE_VERSION`, D7), the image moves on a
# rebuild, and `harnessed update` reports claude as tracking upstream rather than as a failure.
# The old guard's dated observation stands as history: as published on 2026-08-12, install.sh
# appended its argument only when non-empty, so an empty value silently installed the default.
RUN curl -fsSL https://claude.ai/install.sh | bash

# ACP adapter for `harnessed container-acp claude` (#530). The claude binary has no ACP mode, so
# claude-agent-acp speaks ACP on stdio and drives claude through @anthropic-ai/claude-agent-sdk.
# No default: the pin lives in catalog/agents/claude/agent.yaml (build_args), the one place
# `harnessed update` looks. The cache mounts and the chown after them follow harnessed-base.
ARG CLAUDE_AGENT_ACP_VERSION
# THE GUARD IS THE PIN, as for codex: an omitted --build-arg leaves `pkg@`, which installs the newest.
RUN --mount=type=cache,target=/home/harnessed/.cache/mise,id=harnessed-mise,uid=1000,gid=1000,sharing=locked \
    --mount=type=cache,target=/home/harnessed/.cache/pnpm,id=harnessed-pnpm-meta,uid=1000,gid=1000,sharing=shared \
    : "${CLAUDE_AGENT_ACP_VERSION:?required build-arg is empty or unset — refusing to install an unpinned claude-agent-acp}" && \
    pnpm add -g "@agentclientprotocol/claude-agent-acp@${CLAUDE_AGENT_ACP_VERSION}"
# Literal `harnessed`: the base's USERNAME ARG does not carry across FROM.
USER root
RUN chown harnessed:harnessed /home/harnessed /home/harnessed/.cache
# The adapter spawns this instead of claude, so the stack's MCP hub reaches the session. See the file.
COPY catalog/base/harnessed-claude-acp-cli /usr/local/bin/harnessed-claude-acp-cli
RUN chmod 0755 /usr/local/bin/harnessed-claude-acp-cli
USER harnessed

CMD ["/bin/bash"]
