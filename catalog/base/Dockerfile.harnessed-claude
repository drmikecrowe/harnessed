# harnessed-claude — the claude harness image.
# FROM harnessed-base (lineage only, §6) + the Claude Code CLI. Build the base first.

FROM harnessed-base:latest

# Install Claude Code globally via the official installer (into ~/.local/bin, already on PATH).
#
# The version is passed as the installer's own positional argument — its documented interface is
# `install.sh [stable|latest|VERSION]`. `--` ends bash's own option parsing so the value can never
# be read as a flag.
#
# THE GUARD IS THE PIN. An empty CLAUDE_VERSION is never a valid pin, so the build must fail rather
# than hand the installer an empty argument and accept whatever it decides that means. That holds
# whatever the vendor script does — which is the point: this guard does not rest on the installer's
# current behaviour, and it must not be removed on the strength of reading that behaviour once.
# `ARG` with no default yields exactly that empty string whenever a build path omits `--build-arg`.
#
# What prompted it (an observation, dated, not a standing claim about someone else's script): as
# published on 2026-08-12, `install.sh` validated its argument only when non-empty and appended it
# only when non-empty, so an empty value installed the vendor default and exited 0 — a silently
# unpinned CLI behind a manifest that reads as pinned. Found by adversarial review of 03d7a65. The
# tests hold the guard's own behaviour (empty => build fails, installer never runs); they cannot
# hold the sentence above, which is why it is written as a dated observation.
#
# No default on the ARG: the pin lives in catalog/agents/claude/agent.yaml (AC-7), which is the one
# place `harnessed update` looks. A default here would be a second copy, free to drift from the first.
ARG CLAUDE_VERSION
# TEMPORARY DIAGNOSTIC — remove before merge. The installer's first filesystem act is
# `mkdir -p "$HOME/.claude/downloads"`, which on GitHub's runner (podman 5.8.4) fails with
# "Permission denied" while the same layer builds locally (podman 6.0.2). Nothing in this repo
# changed between the last green run and the first red one, so print what the build actually sees
# rather than guess at it.
RUN id; echo "HOME=$HOME"; ls -ldn /home/harnessed /home/harnessed/.cache /home/harnessed/.local; \
    (mkdir -p /home/harnessed/.probe && echo PROBE_MKDIR_OK) || echo PROBE_MKDIR_DENIED
RUN : "${CLAUDE_VERSION:?required build-arg is empty or unset — refusing to install an unpinned Claude Code}" && \
    curl -fsSL https://claude.ai/install.sh | bash -s -- "${CLAUDE_VERSION}"

CMD ["/bin/bash"]
