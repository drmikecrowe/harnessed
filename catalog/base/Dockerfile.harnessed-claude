# harnessed-claude — the claude harness image.
# FROM harnessed-base (lineage only, §6) + the Claude Code CLI. Build the base first.

FROM harnessed-base:latest

# Install Claude Code globally via the official installer (into ~/.local/bin, already on PATH).
#
# The version is passed as the installer's own positional argument — its documented interface is
# `install.sh [stable|latest|VERSION]`, and it validates the argument before use. Nothing about the
# integrity path is bypassed (NC-9): the installer still takes the sha256 from the versioned
# manifest.json and verifies the binary before running it. `--` ends bash's own option parsing so
# the value can never be read as a flag.
#
# No default: the pin lives in catalog/agents/claude/agent.yaml (AC-7), which is the one place
# `harnessed update` looks. A default here would be a second copy, free to drift from the first.
ARG CLAUDE_VERSION
RUN curl -fsSL https://claude.ai/install.sh | bash -s -- "${CLAUDE_VERSION}"

CMD ["/bin/bash"]
