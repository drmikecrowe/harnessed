#!/usr/bin/env bash
# harnessed in-image supply-chain scan (BLD-02). Baked into harnessed-base; invoked as the final RUN
# layer of every assembled stack image (emit.write_derived_dockerfile). Scans what the build actually
# installed — mise-managed node globals and recipe installs under ~/.claude — because those vendor no
# top-level lockfile a host-side scan could see.
#
# ADVISORY, never gating. harnessed installs third-party agent tooling by running upstream installers,
# whose JS dependency trees almost always carry open HIGHs at any moment — a hard build-gate on those
# would make the recipe system unusable. So the scan REPORTS posture and always exits 0. Each scanner
# runs in JSON mode; a single compact severity summary is printed (raw JSON only with
# HARNESSED_SCAN_VERBOSE=1) and a consolidated report is written to ~/.harnessed/scan-report.json,
# which the launcher copies into the stack profile dir.
#
# TOKEN-GATED SCANNERS. osv-scanner + pip-audit are credential-free and always run. snyk and socket
# need tokens, which NEVER exist at build time (`harnessed build` is deliberately credential-free —
# recipe verification must never depend on 1Password being authorized). They run under
# `harnessed rescan <image>`, which resolves ~/.config/harnessed/.env{,.schema} on the HOST (varlock)
# and injects the tokens into a throwaway container as env. So a build prints "skipped (no token)"
# for both and that is correct, expected behavior — not a degraded state.
set -uo pipefail

HOME_DIR="${HOME:-/home/harnessed}"
REPORT_DIR="$HOME_DIR/.harnessed"
REPORT="$REPORT_DIR/scan-report.json"
WORK="$(mktemp -d)"
MANIFEST="$WORK/manifest"
: >"$MANIFEST"
mkdir -p "$REPORT_DIR"

# Scanner tokens. Two arrival paths, both env-only — never a build-arg, so never baked into image
# history. Env wins over the build secret (an explicit `rescan` token beats a stale build secret):
#   * build : --mount=type=secret,id=snyk_token — normally ABSENT (build is credential-free).
#   * rescan: `harnessed rescan <image>` injects SNYK_TOKEN / SOCKET_CLI_API_TOKEN as container env.
if [[ -z "${SNYK_TOKEN:-}" && -r /run/secrets/snyk_token ]]; then
    SNYK_TOKEN="$(cat /run/secrets/snyk_token)"
    export SNYK_TOKEN
fi
# The Socket CLI reads SOCKET_CLI_API_TOKEN / SOCKET_CLI_ORG_SLUG. Accept the SOCKET_SECURITY_API_KEY
# name too (what Socket's GitHub Action uses, and what older harnessed docs told operators to declare)
# so an existing .env.schema keeps working; the canonical name wins when both are set.
if [[ -z "${SOCKET_CLI_API_TOKEN:-}" && -n "${SOCKET_SECURITY_API_KEY:-}" ]]; then
    SOCKET_CLI_API_TOKEN="$SOCKET_SECURITY_API_KEY"
    export SOCKET_CLI_API_TOKEN
fi

# A node_modules tree installed by an upstream installer vendors no top-level manifest, so neither
# snyk nor socket can see it. Synthesize one: write a package.json naming every on-disk package at
# its installed version, and symlink the real tree in beside it. Echoes the temp dir (caller rm -rf's).
synth_manifest_dir() {
    local nm="$1" tmp
    tmp="$(mktemp -d)" || return 1
    ln -s "$nm" "$tmp/node_modules"
    python3 - "$nm" >"$tmp/package.json" <<'PY'
import sys, os, json
nm = sys.argv[1]
deps = {}
def add(d):
    try:
        with open(os.path.join(d, "package.json")) as f:
            p = json.load(f)
        deps[p["name"]] = p.get("version", "*")
    except Exception:
        pass
for entry in sorted(os.listdir(nm)):
    path = os.path.join(nm, entry)
    if not os.path.isdir(path):
        continue
    if entry.startswith("@"):                 # scoped packages live one level down
        for sub in sorted(os.listdir(path)):
            add(os.path.join(path, sub))
    else:
        add(path)
json.dump({"name": "harnessed-globals-audit", "version": "0.0.0", "dependencies": deps}, sys.stdout)
PY
    printf '%s' "$tmp"
}

# Stable, filesystem-safe slug for a scanner label ("recipe: foo" -> "recipe__foo").
slug() { printf '%s' "$1" | tr -c 'A-Za-z0-9' '_'; }

snyk_scan() {
    local nm="$1" label="$2" tmp out
    [[ -d "$nm" ]] || return 0
    command -v snyk >/dev/null 2>&1 || return 0
    [[ -n "${SNYK_TOKEN:-}" ]] || return 0
    echo "  · snyk: ${label}"
    tmp="$(synth_manifest_dir "$nm")" || return 0
    out="$WORK/snyk-$(slug "$label").json"
    ( cd "$tmp" && snyk test --json ) >"$out" 2>/dev/null
    rm -rf "$tmp"
    [[ -s "$out" ]] && printf 'snyk|%s|%s\n' "$label" "$out" >>"$MANIFEST"
}

# Every socket API call needs an org slug. Interactively, socket reads one from ~/.config/socket —
# which does not exist in a container, so a token alone would fail with "org slug is required".
# Derive it from the token instead (one API call, memoized): a rescan then needs nothing but a token.
# SOCKET_CLI_ORG_SLUG still wins if the operator set one explicitly.
SOCKET_ORG_CACHED=""
socket_org() {
    [[ -n "${SOCKET_CLI_ORG_SLUG:-}" ]] && { printf '%s' "$SOCKET_CLI_ORG_SLUG"; return 0; }
    [[ -n "$SOCKET_ORG_CACHED" ]] && { printf '%s' "$SOCKET_ORG_CACHED"; return 0; }
    SOCKET_ORG_CACHED="$(socket organization list --json --no-banner --no-spinner 2>/dev/null \
        | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
    orgs = ((d.get("data") or {}).get("organizations") or []) if d.get("ok") else []
    print(orgs[0].get("slug", "") if orgs else "")
except Exception:
    print("")')"
    printf '%s' "$SOCKET_ORG_CACHED"
}

# socket has no offline mode: `scan create` uploads the synthesized manifest and returns a scan id
# (1 quota unit), then `scan view <id>` returns the per-package alerts. --tmp keeps the scan off the
# org's alerts page — this is an advisory posture check, not the org's system of record.
socket_scan() {
    local nm="$1" label="$2" tmp out id org
    [[ -d "$nm" ]] || return 0
    command -v socket >/dev/null 2>&1 || return 0
    [[ -n "${SOCKET_CLI_API_TOKEN:-}" ]] || return 0
    echo "  · socket: ${label}"
    org="$(socket_org)"
    [[ -n "$org" ]] || { echo "    (socket: no org for this token — skipped)"; return 0; }
    tmp="$(synth_manifest_dir "$nm")" || return 0
    id="$(cd "$tmp" && socket scan create --json --tmp --no-interactive --no-banner --no-spinner \
            --org "$org" . 2>/dev/null \
          | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
    print((d.get("data") or {}).get("id", "") if d.get("ok") else "")
except Exception:
    print("")')"
    rm -rf "$tmp"
    [[ -n "$id" ]] || { echo "    (socket scan create failed — skipped)"; return 0; }
    out="$WORK/socket-$(slug "$label").json"
    # --org here too: `scan view` is an org-scoped endpoint. Interactively it falls back to the
    # default org in ~/.config/socket, which a container does not have — omit it and the call fails
    # silently, leaving socket contributing nothing while still LOOKING like it ran.
    socket scan view "$id" --json --no-banner --no-spinner --org "$org" >"$out" 2>/dev/null
    [[ -s "$out" ]] && printf 'socket|%s|%s\n' "$label" "$out" >>"$MANIFEST"
}

echo "== harnessed supply-chain scan (advisory) =="

# Say out loud which token-gated scanners are sitting out, and why. Silence here reads as "snyk ran
# and found nothing", which is the opposite of the truth.
[[ -n "${SNYK_TOKEN:-}" ]] \
    || echo "  · snyk: skipped (no SNYK_TOKEN — credentialed scan runs in \`harnessed rescan\`)"
[[ -n "${SOCKET_CLI_API_TOKEN:-}" ]] \
    || echo "  · socket: skipped (no SOCKET_CLI_API_TOKEN — credentialed scan runs in \`harnessed rescan\`)"

# 1. mise-installed node globals (node-release-bundled npm/corepack), deduped via realpath.
declare -A seen=()
for nm in "$HOME_DIR"/.local/share/mise/installs/node/*/lib/node_modules; do
    [[ -d "$nm" ]] || continue
    real="$(realpath "$nm")"
    [[ -n "${seen[$real]:-}" ]] && continue
    seen[$real]=1
    snyk_scan "$real" "node globals"
    socket_scan "$real" "node globals"
done
unset seen

# 2. recipe-installed node trees under the Claude-canonical profile.
for nm in "$HOME_DIR"/.claude/skills/*/node_modules "$HOME_DIR"/.claude/commands/*/node_modules; do
    [[ -d "$nm" ]] || continue
    real="$(realpath "$nm")"
    label="recipe: $(basename "$(dirname "$nm")")"
    snyk_scan "$real" "$label"
    socket_scan "$real" "$label"
done

# 3. osv-scanner over recipe trees that ship a real lockfile (sees bun.lock/package-lock that snyk's
#    synth manifest misses). One JSON pass over the whole profile.
if command -v osv-scanner >/dev/null 2>&1; then
    osv_dirs=()
    [[ -d "$HOME_DIR/.claude/skills" ]] && osv_dirs+=("$HOME_DIR/.claude/skills")
    [[ -d "$HOME_DIR/.claude/commands" ]] && osv_dirs+=("$HOME_DIR/.claude/commands")
    if [[ ${#osv_dirs[@]} -gt 0 ]]; then
        echo "  · osv-scanner: recipe lockfiles"
        osv-scanner scan source --recursive --format json "${osv_dirs[@]}" >"$WORK/osv.json" 2>/dev/null
        [[ -s "$WORK/osv.json" ]] && printf 'osv|recipe lockfiles|%s\n' "$WORK/osv.json" >>"$MANIFEST"
    fi
fi

# 4. pip-audit over the active Python env.
if command -v pip-audit >/dev/null 2>&1; then
    echo "  · pip-audit: python env"
    pip-audit --format=json >"$WORK/pip-audit.json" 2>/dev/null
    [[ -s "$WORK/pip-audit.json" ]] && printf 'pip-audit|python env|%s\n' "$WORK/pip-audit.json" >>"$MANIFEST"
fi

# Summarize every scanner's JSON into one compact table + a consolidated report. Advisory only.
HARNESSED_SCAN_REPORT="$REPORT" python3 - "$MANIFEST" <<'PY'
import sys, os, json

rows = []   # {source, tool, critical, high, other, notable:[...]}

def sev_from_cvss(score):
    try:
        s = float(score)
    except (TypeError, ValueError):
        return None
    if s >= 9.0: return "critical"
    if s >= 7.0: return "high"
    if s >= 4.0: return "medium"
    if s > 0:    return "low"
    return None

def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None

def parse_snyk(doc):
    # snyk --json is one object, or a list when multiple projects are detected. Dedup by vuln id.
    projects = doc if isinstance(doc, list) else [doc]
    by_id = {}
    for proj in projects:
        for v in (proj or {}).get("vulnerabilities", []) or []:
            vid = v.get("id")
            if vid:
                by_id[vid] = ((v.get("severity") or "").lower(), v.get("packageName") or v.get("name") or "?")
    return list(by_id.values())

def parse_osv(doc):
    # osv-scanner --format json: results[].packages[].groups[].max_severity is a CVSS score string.
    items = []
    for res in (doc or {}).get("results", []) or []:
        for pkg in res.get("packages", []) or []:
            name = (pkg.get("package") or {}).get("name", "?")
            for grp in pkg.get("groups", []) or []:
                sev = sev_from_cvss(grp.get("max_severity"))
                if sev:
                    items.append((sev, name))
    return items

def parse_pip_audit(doc):
    # pip-audit --format=json: {"dependencies":[{"name","vulns":[...]}]} (no severity field).
    items = []
    deps = doc.get("dependencies", []) if isinstance(doc, dict) else (doc or [])
    for dep in deps:
        for _v in dep.get("vulns", []) or []:
            items.append(("unknown", dep.get("name", "?")))
    return items

def parse_socket(doc):
    # `socket scan view --json`: {"ok":true,"data":[{name, version, alerts:[{severity, ...}]}]}.
    # Socket's severity vocabulary is critical/high/middle/low — "middle", NOT "medium".
    if not (isinstance(doc, dict) and doc.get("ok")):
        return []
    sev_map = {"critical": "critical", "high": "high", "middle": "medium", "low": "low"}
    items = []
    for pkg in doc.get("data") or []:
        name = pkg.get("name") or "?"
        for alert in pkg.get("alerts") or []:
            # `missingLockfile` is an artifact of OUR synthesized manifest (synth_manifest_dir writes
            # a package.json with no lockfile beside it), not a property of the installed tree. Report
            # it and every scan carries a phantom HIGH forever.
            if alert.get("type") == "missingLockfile":
                continue
            sev = sev_map.get((alert.get("severity") or "").lower())
            if sev:
                items.append((sev, name))
    return items

PARSERS = {"snyk": parse_snyk, "osv": parse_osv, "pip-audit": parse_pip_audit,
           "socket": parse_socket}

with open(sys.argv[1]) as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        tool, source, path = line.split("|", 2)
        doc = load(path)
        if doc is None:
            continue
        items = PARSERS[tool](doc)
        crit = sum(1 for s, _ in items if s == "critical")
        high = sum(1 for s, _ in items if s == "high")
        notable, seen = [], set()
        for want in ("critical", "high"):
            for s, pkg in items:
                if s == want and pkg not in seen:
                    seen.add(pkg); notable.append(pkg)
        rows.append({"source": source, "tool": tool, "critical": crit,
                     "high": high, "other": len(items) - crit - high, "notable": notable[:4]})

tot_c = sum(r["critical"] for r in rows)
tot_h = sum(r["high"] for r in rows)

report = {"advisory": True, "gating": 0,
          "totals": {"critical": tot_c, "high": tot_h},
          "sources": rows}
try:
    with open(os.environ["HARNESSED_SCAN_REPORT"], "w") as f:
        json.dump(report, f, indent=2)
except Exception:
    pass

flagged = [r for r in rows if r["critical"] or r["high"]]
print("")
print("  supply-chain summary — advisory (build not gated)")
if not rows:
    print("  (no scanner output — scanner tokens absent and/or scanners missing)")
elif not flagged:
    print("  no high/critical advisories across %d source(s)." % len(rows))
else:
    print("  %-34s %4s %4s   notable packages" % ("SOURCE", "CRIT", "HIGH"))
    for r in sorted(flagged, key=lambda r: (-r["critical"], -r["high"])):
        label = ("%s · %s" % (r["tool"], r["source"]))[:34]
        print("  %-34s %4d %4d   %s" % (label, r["critical"], r["high"], ", ".join(r["notable"])))
    print("  " + "-" * 62)
print("  %d critical · %d high across %d source(s) · 0 gating" % (tot_c, tot_h, len(rows)))
print("  full report: %s" % os.environ.get("HARNESSED_SCAN_REPORT", "?"))
print("")
PY

# Escape hatch: dump raw scanner JSON for debugging (suppressed by default to keep builds readable).
if [[ -n "${HARNESSED_SCAN_VERBOSE:-}" ]]; then
    echo "-- HARNESSED_SCAN_VERBOSE: raw scanner JSON --"
    for f in "$WORK"/*.json; do
        [[ -e "$f" ]] || continue
        echo "### $f"; cat "$f"
    done
fi

rm -rf "$WORK"
exit 0
