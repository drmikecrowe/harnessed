#!/usr/bin/env bash
# harnessed in-image supply-chain scan (BLD-02). Baked into harnessed-base; invoked as the final RUN
# layer of every assembled stack image (emit.write_derived_dockerfile). Scans what the build actually
# installed — mise-managed node globals and recipe installs under ~/.claude — because those vendor no
# top-level lockfile a host-side scan could see.
#
# ADVISORY, never gating. harnessed installs third-party agent tooling by running upstream installers,
# whose JS dependency trees almost always carry open HIGHs at any moment — a hard build-gate on those
# would make the recipe system unusable. So the scan REPORTS posture and always exits 0. Each scanner
# runs in JSON mode; a single compact severity summary is printed (raw JSON only with
# HARNESSED_SCAN_VERBOSE=1) and a consolidated report is written to ~/.harnessed/scan-report.json,
# which the launcher copies into the stack profile dir.
#
# TOKEN-GATED SCANNERS. osv-scanner + pip-audit are credential-free and always run. snyk and socket
# need tokens, which NEVER exist at build time (`harnessed build` is deliberately credential-free —
# recipe verification must never depend on 1Password being authorized). They run under
# `harnessed rescan <image>`, which resolves ~/.config/harnessed/.env{,.schema} on the HOST (varlock)
# and injects the tokens into a throwaway container as env. So a build prints "skipped (no token)"
# for both and that is correct, expected behavior — not a degraded state.
set -uo pipefail

HOME_DIR="${HOME:-/home/harnessed}"
REPORT_DIR="$HOME_DIR/.harnessed"
REPORT="$REPORT_DIR/scan-report.json"
WORK="$(mktemp -d)"
MANIFEST="$WORK/manifest"
# Every scanner we COMMIT to running is recorded here, before it runs. The manifest only ever gets a
# line when a scanner produced parseable output, so a scanner that runs and yields nothing would
# otherwise vanish from the report entirely — 5 of 6 scanners silent still reads as a clean scan.
# Reconciling attempts against the manifest is what lets the summary name what it did NOT see.
ATTEMPTS="$WORK/attempts"
: >"$MANIFEST"
: >"$ATTEMPTS"
mkdir -p "$REPORT_DIR"

# Scanner tokens. Two arrival paths, both env-only — never a build-arg, so never baked into image
# history. Env wins over the build secret (an explicit `rescan` token beats a stale build secret):
#   * build : --mount=type=secret,id=snyk_token — normally ABSENT (build is credential-free).
#   * rescan: `harnessed rescan <image>` injects SNYK_TOKEN / SOCKET_CLI_API_TOKEN as container env.
if [[ -z "${SNYK_TOKEN:-}" && -r /run/secrets/snyk_token ]]; then
    SNYK_TOKEN="$(cat /run/secrets/snyk_token)"
    export SNYK_TOKEN
fi
# The Socket CLI reads SOCKET_CLI_API_TOKEN / SOCKET_CLI_ORG_SLUG. Accept the SOCKET_SECURITY_API_KEY
# name too (what Socket's GitHub Action uses, and what older harnessed docs told operators to declare)
# so an existing .env.schema keeps working; the canonical name wins when both are set.
if [[ -z "${SOCKET_CLI_API_TOKEN:-}" && -n "${SOCKET_SECURITY_API_KEY:-}" ]]; then
    SOCKET_CLI_API_TOKEN="$SOCKET_SECURITY_API_KEY"
    export SOCKET_CLI_API_TOKEN
fi

# A node_modules tree installed by an upstream installer vendors no top-level manifest, so neither
# snyk nor socket can see it. Synthesize one: write a package.json naming every on-disk package at
# its installed version, and symlink the real tree in beside it. Echoes the temp dir (caller rm -rf's).
synth_manifest_dir() {
    local nm="$1" tmp
    tmp="$(mktemp -d)" || return 1
    ln -s "$nm" "$tmp/node_modules"
    python3 - "$nm" >"$tmp/package.json" <<'PY'
import sys, os, json
nm = sys.argv[1]
deps = {}
def add(d):
    try:
        with open(os.path.join(d, "package.json")) as f:
            p = json.load(f)
        deps[p["name"]] = p.get("version", "*")
    except Exception:
        pass
for entry in sorted(os.listdir(nm)):
    path = os.path.join(nm, entry)
    if not os.path.isdir(path):
        continue
    if entry.startswith("@"):                 # scoped packages live one level down
        for sub in sorted(os.listdir(path)):
            add(os.path.join(path, sub))
    else:
        add(path)
json.dump({"name": "harnessed-globals-audit", "version": "0.0.0", "dependencies": deps}, sys.stdout)
PY
    printf '%s' "$tmp"
}

# Stable, filesystem-safe slug for a scanner label ("recipe: foo" -> "recipe__foo").
slug() { printf '%s' "$1" | tr -c 'A-Za-z0-9' '_'; }

# BOTH ledgers are `|`-separated with NO escaping, and the summary block splits them by POSITION.
# So a `|` anywhere in a field silently shifts every field after it, and the two readers fail in
# different ways: an `unrun` line stops being recognised as unrun (the scanner reappears as
# "probably broken"), and a MANIFEST line's third field — a file path — stops pointing at the
# scanner's JSON. Neither surfaces as an error; both just report the wrong thing.
#
# The labels are not all literals. `recipe: $(basename …)` is a directory name under
# ~/.claude/skills, which a recipe controls. Strip the separator at the single choke point rather
# than trusting each of the six write sites to remember, and never rely on it in the parser.
nosep() { printf '%s' "${1//|/ }"; }

# A scanner we committed to but never started — no token, or the binary is not installed. It has to
# reach the report, or a consumer of scan-report.json cannot tell a skipped scanner from one that
# never existed, and 1-of-6 coverage reads as a clean scan (bd harnessed-wx9). Distinct from a
# no-output row, which means the scanner RAN and is probably broken. `|` is the field separator, so
# strip any from the reason rather than corrupting the ledger.
record_skip() {
    local tool="$1" label="$2" reason="$3"
    printf '%s|%s|unrun|%s\n' "$(nosep "$tool")" "$(nosep "$label")" "$(nosep "$reason")" \
        >>"$ATTEMPTS"
}

# Every scanner below is NETWORK-BOUND and none of them self-limit. bd harnessed-8px.28: a `socket`
# invocation blocked for 71 HOURS at 0% CPU, having written nothing, and the scan container sat
# there for three days. Nothing upstream of it had a timeout either, so `harnessed build` would have
# waited forever.
#
# `-k 10` matters and is not boilerplate: that container ignored SIGTERM ("StopSignal SIGTERM failed
# to stop container in 10 seconds, resorting to SIGKILL"), so a plain TERM would not have reclaimed
# it. Send TERM, then KILL 10s later.
#
# Per-CALL rather than one bound over the whole script, so one wedged scanner costs its own result
# and not the other three. `timeout` exits 124 on expiry, which every call site below turns into an
# explicit "timed out" skip — the summary must say a scanner was cut off, never silently report it
# as having contributed nothing.
SCAN_TIMEOUT="${HARNESSED_SCAN_TIMEOUT:-120}"
bounded() { timeout -k 10 "$SCAN_TIMEOUT" "$@"; }

snyk_scan() {
    local nm="$1" label="$2" tmp out
    [[ -d "$nm" ]] || return 0
    command -v snyk >/dev/null 2>&1 || { record_skip snyk "$label" "snyk not installed"; return 0; }
    [[ -n "${SNYK_TOKEN:-}" ]] || { record_skip snyk "$label" "no SNYK_TOKEN"; return 0; }
    echo "  · snyk: ${label}"
    printf 'snyk|%s\n' "$(nosep "$label")" >>"$ATTEMPTS"
    tmp="$(synth_manifest_dir "$nm")" || return 0
    out="$WORK/snyk-$(slug "$label").json"
    ( cd "$tmp" && bounded snyk test --json ) >"$out" 2>/dev/null
    [[ $? -eq 124 ]] && { record_skip snyk "$label" "timed out after ${SCAN_TIMEOUT}s"; return 0; }
    rm -rf "$tmp"
    [[ -s "$out" ]] && printf 'snyk|%s|%s\n' "$(nosep "$label")" "$out" >>"$MANIFEST"
}

# Every socket API call needs an org slug. Interactively, socket reads one from ~/.config/socket —
# which does not exist in a container, so a token alone would fail with "org slug is required".
# Derive it from the token instead (one API call, memoized): a rescan then needs nothing but a token.
# SOCKET_CLI_ORG_SLUG still wins if the operator set one explicitly.
SOCKET_ORG_CACHED=""
socket_org() {
    [[ -n "${SOCKET_CLI_ORG_SLUG:-}" ]] && { printf '%s' "$SOCKET_CLI_ORG_SLUG"; return 0; }
    [[ -n "$SOCKET_ORG_CACHED" ]] && { printf '%s' "$SOCKET_ORG_CACHED"; return 0; }
    SOCKET_ORG_CACHED="$(bounded socket organization list --json --no-banner --no-spinner 2>/dev/null \
        | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
    orgs = ((d.get("data") or {}).get("organizations") or []) if d.get("ok") else []
    print(orgs[0].get("slug", "") if orgs else "")
except Exception:
    print("")')"
    printf '%s' "$SOCKET_ORG_CACHED"
}

# socket has no offline mode: `scan create` uploads the synthesized manifest and returns a scan id
# (1 quota unit), then `scan view <id>` returns the per-package alerts. --tmp keeps the scan off the
# org's alerts page — this is an advisory posture check, not the org's system of record.
socket_scan() {
    local nm="$1" label="$2" tmp out id org
    [[ -d "$nm" ]] || return 0
    command -v socket >/dev/null 2>&1 || { record_skip socket "$label" "socket not installed"; return 0; }
    [[ -n "${SOCKET_CLI_API_TOKEN:-}" ]] || { record_skip socket "$label" "no SOCKET_CLI_API_TOKEN"; return 0; }
    echo "  · socket: ${label}"
    printf 'socket|%s\n' "$(nosep "$label")" >>"$ATTEMPTS"
    org="$(socket_org)"
    [[ -n "$org" ]] || { echo "    (socket: no org for this token — skipped)"; return 0; }
    tmp="$(synth_manifest_dir "$nm")" || return 0
    id="$(cd "$tmp" && bounded socket scan create --json --tmp --no-interactive --no-banner --no-spinner \
            --org "$org" . 2>/dev/null \
          | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
    print((d.get("data") or {}).get("id", "") if d.get("ok") else "")
except Exception:
    print("")')"
    rm -rf "$tmp"
    [[ -n "$id" ]] || { echo "    (socket scan create failed — skipped)"; return 0; }
    out="$WORK/socket-$(slug "$label").json"
    # --org here too: `scan view` is an org-scoped endpoint. Interactively it falls back to the
    # default org in ~/.config/socket, which a container does not have — omit it and the call fails
    # silently, leaving socket contributing nothing while still LOOKING like it ran.
    bounded socket scan view "$id" --json --no-banner --no-spinner --org "$org" >"$out" 2>/dev/null
    [[ $? -eq 124 ]] && { record_skip socket "$label" "timed out after ${SCAN_TIMEOUT}s"; return 0; }
    [[ -s "$out" ]] && printf 'socket|%s|%s\n' "$(nosep "$label")" "$out" >>"$MANIFEST"
}

echo "== harnessed supply-chain scan (advisory) =="

# Say out loud which token-gated scanners are sitting out, and why. Silence here reads as "snyk ran
# and found nothing", which is the opposite of the truth.
[[ -n "${SNYK_TOKEN:-}" ]] \
    || echo "  · snyk: skipped (no SNYK_TOKEN — credentialed scan runs in \`harnessed rescan\`)"
[[ -n "${SOCKET_CLI_API_TOKEN:-}" ]] \
    || echo "  · socket: skipped (no SOCKET_CLI_API_TOKEN — credentialed scan runs in \`harnessed rescan\`)"

# 1. mise-installed node globals (node-release-bundled npm/corepack), deduped via realpath.
declare -A seen=()
for nm in "$HOME_DIR"/.local/share/mise/installs/node/*/lib/node_modules; do
    [[ -d "$nm" ]] || continue
    real="$(realpath "$nm")"
    [[ -n "${seen[$real]:-}" ]] && continue
    seen[$real]=1
    snyk_scan "$real" "node globals"
    socket_scan "$real" "node globals"
done
unset seen

# 2. recipe-installed node trees under the Claude-canonical profile.
for nm in "$HOME_DIR"/.claude/skills/*/node_modules "$HOME_DIR"/.claude/commands/*/node_modules; do
    [[ -d "$nm" ]] || continue
    real="$(realpath "$nm")"
    label="recipe: $(basename "$(dirname "$nm")")"
    snyk_scan "$real" "$label"
    socket_scan "$real" "$label"
done

# 3. osv-scanner over recipe trees that ship a real lockfile (sees bun.lock/package-lock that snyk's
#    synth manifest misses). One JSON pass over the whole profile.
if command -v osv-scanner >/dev/null 2>&1; then
    osv_dirs=()
    [[ -d "$HOME_DIR/.claude/skills" ]] && osv_dirs+=("$HOME_DIR/.claude/skills")
    [[ -d "$HOME_DIR/.claude/commands" ]] && osv_dirs+=("$HOME_DIR/.claude/commands")
    if [[ ${#osv_dirs[@]} -gt 0 ]]; then
        echo "  · osv-scanner: recipe lockfiles"
        printf 'osv|recipe lockfiles\n' >>"$ATTEMPTS"
        bounded osv-scanner scan source --recursive --format json "${osv_dirs[@]}" >"$WORK/osv.json" 2>/dev/null
        osv_rc=$?
        # osv-scanner's exit codes, verified against 2.5.1 rather than assumed:
        #   0   scanned, no vulnerabilities   -> a real (clean) result, JSON on stdout
        #   1   scanned, vulnerabilities found -> a real result, JSON on stdout
        #   127 usage error (bad flag, bad path, unknown subcommand) -> genuinely broken
        #   128 "No package sources found": ZERO packages extracted, whether because nothing ships
        #       a lockfile or because the lockfiles present contain no packages
        #
        # 128 is the one that made every clean build print a warning. Nothing went wrong and there
        # was nothing to scan, so it is a SKIP, not a result; left to fall through it writes no
        # manifest line, and the reconciler below can only read that as "ran but produced NO
        # parseable output" — i.e. a broken scanner. 127 deliberately keeps falling through, since
        # a broken invocation is exactly what that bucket is for.
        #
        # The branches are exclusive with the manifest write on purpose. Unlike snyk_scan and
        # socket_scan, this block is inline and cannot `return`, so a timeout that still left
        # partial JSON in osv.json used to record BOTH an unrun line and a manifest line — the
        # same scanner reported twice, once as skipped and once as a complete result built from a
        # truncated file.
        if [[ $osv_rc -eq 124 ]]; then
            record_skip osv "recipe lockfiles" "timed out after ${SCAN_TIMEOUT}s"
        elif [[ $osv_rc -eq 128 ]]; then
            record_skip osv "recipe lockfiles" "no package sources found under skills/ or commands/"
        elif [[ -s "$WORK/osv.json" ]]; then
            printf 'osv|recipe lockfiles|%s\n' "$WORK/osv.json" >>"$MANIFEST"
        fi
    else
        record_skip osv "recipe lockfiles" "no skills/ or commands/ dir to scan"
    fi
else
    record_skip osv "recipe lockfiles" "osv-scanner not installed"
fi

# 4. pip-audit over the active Python env.
if command -v pip-audit >/dev/null 2>&1; then
    echo "  · pip-audit: python env"
    printf 'pip-audit|python env\n' >>"$ATTEMPTS"
    bounded pip-audit --format=json >"$WORK/pip-audit.json" 2>/dev/null
    [[ $? -eq 124 ]] && record_skip pip-audit "python env" "timed out after ${SCAN_TIMEOUT}s"
    [[ -s "$WORK/pip-audit.json" ]] && printf 'pip-audit|python env|%s\n' "$WORK/pip-audit.json" >>"$MANIFEST"
else
    record_skip pip-audit "python env" "pip-audit not installed"
fi

# Summarize every scanner's JSON into one compact table + a consolidated report. Advisory only.
HARNESSED_SCAN_REPORT="$REPORT" HARNESSED_SCAN_ATTEMPTS="$ATTEMPTS" python3 - "$MANIFEST" <<'PY'
import sys, os, json

rows = []   # {source, tool, critical, high, other, notable:[...]}

# Advisories with NO patched release anywhere upstream. There is no pin, bump, or removal that
# clears these, so reporting them every build is pure noise that trains people to ignore the scan.
# They are ACKNOWLEDGED, not suppressed: every hit is counted and printed by name below, so the
# summary still says out loud what it is choosing not to count as a HIGH.
#
# Keyed by advisory id, which is what makes this self-expiring. When npm finally ships a fixed
# brace-expansion the ids stop appearing and the entries go dead on their own; a NEW advisory
# against the same package is not in the map and gets reported at full severity. Never key an
# entry by package name — that blinds the scan to the next CVE in the same dependency.
#
# Verified 2026-08-22: npm 11.18.0 (our pin, Dockerfile.harnessed-base), 11.19.0, and 12.0.2
# (`latest`) ALL bundle brace-expansion 5.0.7. Both advisories are fixed in 5.0.9, which no
# published npm release ships. Re-check by extracting node_modules/brace-expansion/package.json
# from the npm tarball; drop the entry the moment it reads >= 5.0.9.
# {advisory id: (package it applies to, why it cannot be fixed)}. BOTH must match before anything
# is acknowledged. The package is a second necessary condition, never a key in its own right — it
# can only ever narrow, so it cannot become the package-name suppression that N2 forbids. It is
# here because one CVE can legitimately affect several packages: an ID-only match would silence a
# finding against some OTHER package that shares the advisory and may well have a fix available.
_REASON = "brace-expansion <5.0.9 DoS; every npm release bundles 5.0.7"
ACKNOWLEDGED = {
    "GHSA-mh99-v99m-4gvg": ("brace-expansion", _REASON),
    "CVE-2026-14257":      ("brace-expansion", _REASON),
    "GHSA-rgw5-rvv9-x895": ("brace-expansion", _REASON),
    "CVE-2026-69152":      ("brace-expansion", _REASON),
}
# {advisory id: package} — printed, never silently dropped. A dict because snyk reports the same
# vulnerability once per detected project, exactly like the by_id dedup in parse_snyk.
acknowledged_hits = {}

_ID_MAX = 64          # advisory ids are short; anything longer is not one
# CHARACTERS, not bytes. npm caps package names at 214 and we only need enough to identify one; a
# name of 4-byte codepoints is therefore ~4x this in bytes, which is still bounded — the property
# that matters — but is not a 64-byte guarantee and must not be described as one.
_PKG_MAX = 64

def safe_text(value, limit):
    """A third-party string, made safe to print and to store.

    Package names reach a BUILD CONSOLE — a CI log, public for a public repo — and
    scan-report.json. They arrive from scanner output, i.e. ultimately from whoever published the
    package, and nothing upstream bounds or escapes them. An unprintable character here rewrites
    the terminal the summary is drawn on; an unbounded one buries the summary it belongs to.

    Applied at BOTH sinks rather than only the new one. `notable` has carried the same exposure
    all along — `[:4]` bounds how MANY names print, never how long each is — so guarding only the
    acknowledged line would leave the identical hole one row higher and invent a second, weaker
    rule for the same kind of data.
    """
    text = "".join(ch for ch in str(value) if ch.isprintable())
    return (text[:limit] + "…") if len(text) > limit else text

def advisory_ids(v):
    """Every id a snyk vulnerability answers to: its own, plus each CVE/GHSA/etc identifier.

    Snyk keys findings by its own `SNYK-JS-*` id and reports upstream ids under `identifiers`,
    whose key set is not guaranteed (GHSA is often absent where CVE is present). Match on the
    union so an ACKNOWLEDGED entry lands whichever vocabulary this snyk version emits.

    DEFENSIVE ON PURPOSE. `identifiers` is JSON from another program, so its shape is guaranteed
    by nothing: observed as a list of strings, but a bare string, a number, or a nested list are
    all valid JSON and the obvious `for value in values or []` raises TypeError on two of them.
    That exception has nowhere to land — no caller catches it — and the surrounding bash runs
    `set -uo pipefail` WITHOUT -e, so the python dies, the report is never written, and the script
    still exits 0. The build prints no summary at all and looks like it simply had nothing to say.
    """
    ids = set()
    vid = v.get("id")
    if isinstance(vid, str) and vid:
        ids.add(vid[:_ID_MAX])
    identifiers = v.get("identifiers")
    if isinstance(identifiers, dict):
        for values in identifiers.values():
            if isinstance(values, str):     # a bare string would otherwise iterate CHARACTERS,
                values = [values]           # silently matching nothing rather than crashing
            elif not isinstance(values, (list, tuple, set)):
                continue
            for value in values:
                if isinstance(value, str) and value:
                    ids.add(value[:_ID_MAX])
    return ids

def sev_from_cvss(score):
    try:
        s = float(score)
    except (TypeError, ValueError):
        return None
    if s >= 9.0: return "critical"
    if s >= 7.0: return "high"
    if s >= 4.0: return "medium"
    if s > 0:    return "low"
    return None

def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None

def parse_snyk(doc):
    # snyk --json is one object, or a list when multiple projects are detected. Dedup by vuln id.
    projects = doc if isinstance(doc, list) else [doc]
    by_id = {}
    for proj in projects:
        for v in (proj or {}).get("vulnerabilities", []) or []:
            vid = v.get("id")
            if not vid:
                continue
            pkg = safe_text(v.get("packageName") or v.get("name") or "?", _PKG_MAX)
            known = {i for i in advisory_ids(v) & set(ACKNOWLEDGED)
                     if ACKNOWLEDGED[i][0] == pkg}
            if known:
                by_id.pop(vid, None)
                acknowledged_hits[sorted(known)[0]] = pkg
                continue
            by_id[vid] = ((v.get("severity") or "").lower(), pkg)
    return list(by_id.values())

def parse_osv(doc):
    # osv-scanner --format json: results[].packages[].groups[].max_severity is a CVSS score string.
    items = []
    for res in (doc or {}).get("results", []) or []:
        for pkg in res.get("packages", []) or []:
            name = (pkg.get("package") or {}).get("name", "?")
            for grp in pkg.get("groups", []) or []:
                sev = sev_from_cvss(grp.get("max_severity"))
                if sev:
                    items.append((sev, name))
    return items

def parse_pip_audit(doc):
    # pip-audit --format=json: {"dependencies":[{"name","vulns":[...]}]} (no severity field).
    items = []
    deps = doc.get("dependencies", []) if isinstance(doc, dict) else (doc or [])
    for dep in deps:
        for _v in dep.get("vulns", []) or []:
            items.append(("unknown", dep.get("name", "?")))
    return items

def parse_socket(doc):
    # `socket scan view --json`: {"ok":true,"data":[{name, version, alerts:[{severity, ...}]}]}.
    # Socket's severity vocabulary is critical/high/middle/low — "middle", NOT "medium".
    if not (isinstance(doc, dict) and doc.get("ok")):
        return []
    sev_map = {"critical": "critical", "high": "high", "middle": "medium", "low": "low"}
    items = []
    for pkg in doc.get("data") or []:
        name = pkg.get("name") or "?"
        for alert in pkg.get("alerts") or []:
            # `missingLockfile` is an artifact of OUR synthesized manifest (synth_manifest_dir writes
            # a package.json with no lockfile beside it), not a property of the installed tree. Report
            # it and every scan carries a phantom HIGH forever.
            if alert.get("type") == "missingLockfile":
                continue
            sev = sev_map.get((alert.get("severity") or "").lower())
            if sev:
                items.append((sev, name))
    return items

PARSERS = {"snyk": parse_snyk, "osv": parse_osv, "pip-audit": parse_pip_audit,
           "socket": parse_socket}

with open(sys.argv[1]) as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        tool, source, path = line.split("|", 2)
        doc = load(path)
        if doc is None:
            continue
        items = PARSERS[tool](doc)
        crit = sum(1 for s, _ in items if s == "critical")
        high = sum(1 for s, _ in items if s == "high")
        notable, seen = [], set()
        for want in ("critical", "high"):
            for s, pkg in items:
                if s == want and pkg not in seen:
                    seen.add(pkg); notable.append(safe_text(pkg, _PKG_MAX))
        rows.append({"source": source, "tool": tool, "critical": crit,
                     "high": high, "other": len(items) - crit - high, "notable": notable[:4]})

for r in rows:
    r["status"] = "ok"

# COVERAGE IS FIRST-CLASS. A scanner that ran but produced nothing parseable writes no manifest line,
# so without this reconciliation it disappears from sources[] and its silence is indistinguishable
# from a clean result. Reconcile what we COMMITTED to running against what actually reported: every
# attempt with no parseable output stays in sources[] as an explicit no-output entry.
# Two ways to be uncovered, and they mean opposite things (bd harnessed-wx9):
#   no-output  the scanner RAN and yielded nothing parseable  -> it is probably BROKEN
#   unrun      the scanner never started (no token, not installed) -> it was never configured
# Conflating them either hides a broken scanner or cries wolf about a deliberately unconfigured
# one. A ledger line is `tool|source` for an attempt, or `tool|source|unrun|reason` for a skip.
reported = {(r["tool"], r["source"]) for r in rows}
unreported = []
unrun = []
ledger = []
try:
    with open(os.environ["HARNESSED_SCAN_ATTEMPTS"]) as f:
        ledger = [line.rstrip("\n") for line in f if line.strip()]
except Exception:
    pass

# An `unrun` line WINS over a bare attempt line for the same (tool, source). A scanner that
# announced its attempt and only then bailed with a reason — timed out, or nothing to scan —
# writes both lines, and taken at face value it lands in sources[] TWICE: once as an actionable
# skip carrying its reason, and once as "ran but produced nothing", i.e. probably broken. Those
# are contradictory claims about one scanner, and the reasoned one is strictly more informative.
skipped = set()
for line in ledger:
    parts = line.split("|", 3)
    if len(parts) > 2 and parts[2] == "unrun":
        skipped.add((parts[0], parts[1] if len(parts) > 1 else ""))

for line in ledger:
    parts = line.split("|", 3)
    tool, source = parts[0], (parts[1] if len(parts) > 1 else "")
    status = parts[2] if len(parts) > 2 else "attempted"
    row = {"source": source, "tool": tool, "critical": 0, "high": 0,
           "other": 0, "notable": []}
    if status == "unrun":
        row["status"] = "unrun"
        row["reason"] = parts[3] if len(parts) > 3 else ""
        unrun.append(row)
    elif (tool, source) not in reported and (tool, source) not in skipped:
        row["status"] = "no-output"
        unreported.append(row)
# A pair that BOTH reported and skipped is contradictory, and the skip is the safer reading: every
# skip reason here (timed out, nothing to scan) means the run did not complete, so any output it
# left behind is partial. Reporting partial findings as a finished result is the worse error, so
# the `ok` row is dropped and the reasoned skip stands. The bash above now makes the two mutually
# exclusive at the source; this is the second line of defence, because the parser must not depend
# on a guarantee living in a different language two hundred lines away.
skipped_pairs = {(r["tool"], r["source"]) for r in unrun}
rows = [r for r in rows if (r["tool"], r["source"]) not in skipped_pairs]
rows.extend(unreported)
rows.extend(unrun)

tot_c = sum(r["critical"] for r in rows)
tot_h = sum(r["high"] for r in rows)
scanned = [r for r in rows if r["status"] == "ok"]
# Anything we committed to that did not report — whether broken or never started — is a hole in
# the coverage this result claims.
uncovered = unreported + unrun

report = {"advisory": True, "gating": 0,
          "totals": {"critical": tot_c, "high": tot_h},
          "acknowledged": [{"id": vid, "package": pkg, "reason": ACKNOWLEDGED[vid][1]}
                           for vid, pkg in sorted(acknowledged_hits.items())],
          "covered": bool(scanned),
          "coverage": {"attempted": len(rows), "reported": len(scanned),
                       "no_output": [r["tool"] for r in unreported],
                       "unrun": [r["tool"] for r in unrun]},
          "sources": rows}
try:
    with open(os.environ["HARNESSED_SCAN_REPORT"], "w") as f:
        json.dump(report, f, indent=2)
except Exception:
    pass

flagged = [r for r in rows if r["critical"] or r["high"]]
print("")
print("  supply-chain summary — advisory (build not gated)")
if not scanned:
    print("  ⚠ NO COVERAGE — 0 scanners produced output. This is NOT a clean result.")
elif not flagged:
    print("  no high/critical advisories across %d reporting source(s)." % len(scanned))
    # The whole point of the bead: a green line earned by 1 of 6 scanners is a FALSE clean. Say so
    # right where the reassuring sentence is, not only in a warning further down that scrolls past.
    if uncovered:
        print("  ⚠ but %d of %d scanner(s) contributed nothing — this is NOT a full all-clear."
              % (len(uncovered), len(rows)))
else:
    print("  %-34s %4s %4s   notable packages" % ("SOURCE", "CRIT", "HIGH"))
    for r in sorted(flagged, key=lambda r: (-r["critical"], -r["high"])):
        label = ("%s · %s" % (r["tool"], r["source"]))[:34]
        print("  %-34s %4d %4d   %s" % (label, r["critical"], r["high"], ", ".join(r["notable"])))
    print("  " + "-" * 62)
if acknowledged_hits:
    # Not a warning and deliberately not counted above — but never silent either. The list is the
    # audit trail for the decision, so a reader can check the claim instead of trusting the total.
    print("  %d acknowledged advisor%s with no upstream fix (excluded from the totals above):"
          % (len(acknowledged_hits), "y" if len(acknowledged_hits) == 1 else "ies"))
    for vid, pkg in sorted(acknowledged_hits.items()):
        print("      %s · %s — %s" % (vid, pkg, ACKNOWLEDGED[vid][1]))
if unreported:
    print("  ⚠ %d scanner(s) ran but produced NO parseable output — not covered by this result:"
          % len(unreported))
    for r in unreported:
        print("      %s · %s" % (r["tool"], r["source"]))
if unrun:
    # Separate wording from the no-output block on purpose: this list is ACTIONABLE ("set
    # SNYK_TOKEN"), whereas that one means a scanner is misbehaving. Printing the reason is what
    # makes it actionable at all.
    print("  ⚠ %d scanner(s) did not run — not covered by this result:" % len(unrun))
    for r in unrun:
        print("      %s · %s (%s)" % (r["tool"], r["source"], r["reason"] or "no reason recorded"))
print("  %d critical · %d high across %d reporting source(s) · 0 gating"
      % (tot_c, tot_h, len(scanned)))
print("  full report: %s" % os.environ.get("HARNESSED_SCAN_REPORT", "?"))
print("")
PY

# Escape hatch: dump raw scanner JSON for debugging (suppressed by default to keep builds readable).
if [[ -n "${HARNESSED_SCAN_VERBOSE:-}" ]]; then
    echo "-- HARNESSED_SCAN_VERBOSE: raw scanner JSON --"
    for f in "$WORK"/*.json; do
        [[ -e "$f" ]] || continue
        echo "### $f"; cat "$f"
    done
fi

rm -rf "$WORK"
exit 0
