# harnessed-omp — the omp (Oh My Pi) harness image.
#
# FROM harnessed-base (lineage only, §6) + omp (via mise) + the pre-installed
# claude-hooks-bridge extension. omp consumes the SAME Claude-canonical profile
# (.claude/) as the claude harness — the bridge maps Claude hooks/skills at
# runtime (design §8). No re-authoring. Build the base first.
#
# Lazy-built: `ensure_omp_image` (lib/harnessed-common.sh) builds this only when an
# omp stack first launches, so claude-only users never build omp (plan 04-03 / HRN-01).

FROM harnessed-base:latest

# Install omp via mise (mirrors the host install; the base has mise + shims on PATH).
# `mise use -g` lands `omp` on the mise shim PATH. The version itself is NOT named here (AC-11):
# agent.yaml owns it, and a comment restating "the v16 line" is the same drift in prose form —
# it outlived the pin it described once already.
# Supply-chain (T-04-09): omp is the host harness (first-party, MIT-class); scanned on
# build (BLD-02 via build_stack's image-scan path when an omp stack is assembled).
# No default: the launcher supplies OMP_VERSION via --build-arg from catalog/agents/omp/agent.yaml
# (build_args) — the single source of truth. A standalone `podman build` must pass --build-arg.
ARG OMP_VERSION
# omp plugins are Bun-based (the claude-hooks-bridge ships a bun.lock + TS entry). Install bun via
# mise so `omp plugin install` can resolve/run them.
# Pinned for the same reason as OMP_VERSION, and found the same way this file's own lint was proven:
# a bare `bun` here took whatever mise called latest at each build. agent.yaml owns the version and
# states why it is held rather than resolvable; naming it again here would be the AC-11 drift.
ARG BUN_VERSION
# THE GUARD IS THE PIN, as it is for claude (A3). `ARG` with no default yields the empty string on
# any build path that omits `--build-arg`, and MEASURED 2026-08-13: `mise latest 'bun@'` and
# `mise latest 'github:can1357/oh-my-pi@'` BOTH answer with the newest release rather than failing.
# mise reads an empty version as "newest", so an omitted build-arg installs an unpinned tool behind
# a manifest that reads as pinned — the defect this unit removes, reintroduced by a different route.
# BOTH names are guarded, not just the new one: one command acquires both, and a guard covering half
# a command reads as complete while leaving the other half floating.
RUN --mount=type=cache,target=/home/harnessed/.cache/mise,id=harnessed-mise,uid=1000,gid=1000,sharing=locked \
    --mount=type=cache,target=/home/harnessed/.cache/pnpm,id=harnessed-pnpm-meta,uid=1000,gid=1000,sharing=shared \
    --mount=type=cache,target=/home/harnessed/.cache/uv,id=harnessed-uv,uid=1000,gid=1000,sharing=shared \
    : "${OMP_VERSION:?required build-arg is empty or unset — refusing to install an unpinned omp}" && \
    : "${BUN_VERSION:?required build-arg is empty or unset — refusing to install an unpinned bun}" && \
    mise use -g "github:can1357/oh-my-pi@${OMP_VERSION}" "bun@${BUN_VERSION}" && mise install && omp tiny-models download
# Restore what the cache mount took: podman leaves the PARENTS of a cache-mount target owned by root
# in the committed layer, and the next layer here creates ~/.omp as the image user. Same defect,
# same fix, as the first restore in Dockerfile.harnessed-base — read the comment there.
#
# Literal `harnessed`, not ${USERNAME}: that ARG belongs to the BASE's build and does not carry
# across FROM into this one, where it would expand to the empty string and make `USER` fail.
USER root
RUN chown harnessed:harnessed /home/harnessed /home/harnessed/.cache
USER harnessed

# Pre-install the claude-hooks-bridge extension so an omp stack auto-loads it via omp
# extension discovery (no per-launch -e). Owner-authored npm package (MIT); installed
# into the image layer (design §8/§11).
#
# PINNED (was an unpinned `install`, which took whatever npm called latest at build time —
# the same AC-11 drift OMP_VERSION/BUN_VERSION are pinned to avoid). 0.4.0 is the first
# release that INJECTS a bridged hook's SessionStart stdout / UserPromptSubmit
# additionalContext into the omp session, instead of only running the hook and discarding
# its output. Without it a recipe's steering hooks (e.g. codebase-memory-mcp's "use the
# graph tools FIRST" SessionStart reminder) execute but never reach the agent on omp —
# the hooks are populated in settings.json and the bridge runs them, but 0.3.0's
# session_start handler only `ctx.ui.notify`s the output. See the bridge repo's 0.4.0
# release (drmikecrowe/omp-claude-hooks-bridge).
RUN omp plugin install @drmikecrowe/omp-claude-hooks-bridge@0.4.0

CMD ["/bin/bash"]
