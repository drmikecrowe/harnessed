# harnessed-base — toolchain image (mise/node/pnpm/python + common dev tools)
# Lineage root. `harnessed-claude` (and later `harnessed-omp`) build FROM this (§6: FROM = lineage only).
# Built and run on the HOST (no DooD). Home is /home/harnessed for a legible session slug (§15 / D-06).

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America/New_York
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# System dependencies and common build tools.
#
# THE `lib*-dev` ENTRIES ARE CPYTHON'S OPTIONAL-MODULE HEADERS, AND THE LIST MUST STAY COMPLETE.
# mise builds Python from source here, and CPython's build SILENTLY SKIPS any extension module
# whose headers are missing: it notes the omission and exits 0, so the image ships a Python that
# imports fine and then dies at RUNTIME on `import sqlite3`.
#
# Not hypothetical. Without libsqlite3-dev, `repowise mcp` (a stdio MCP server) died on
# `ModuleNotFoundError: No module named '_sqlite3'` the moment hatago spawned it, and the capability
# test could only report the server "not connected" — nothing pointed at Python. The same build was
# also missing _bz2, _curses and readline.
#
# ssl/zlib/ffi were already here because their absence breaks pip and therefore fails LOUDLY during
# the build. The four added alongside them fail QUIETLY, at runtime, in whatever recipe happens to
# import them — which is why they were easy to omit and expensive to find. Keep the set complete
# rather than minimal; the cost is a few MB of headers in a build layer.
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    curl \
    wget \
    unzip \
    ca-certificates \
    libssl-dev \
    zlib1g-dev \
    libffi-dev \
    libsqlite3-dev \
    libbz2-dev \
    libreadline-dev \
    libncurses-dev \
    liblzma-dev \
    vim \
    tree \
    gnupg \
    iptables

# 1Password CLI + desktop app (for SSH signing with op-ssh-sign). BEST-EFFORT: the install pulls
# from downloads.1password.com, which some networks (e.g. locked-down work machines) block. It only
# provides op-ssh-sign for 1Password-based SSH commit signing — the launcher already forwards the
# host agent only when its socket exists (see _ssh_agent_args), so an image without it just can't
# sign via 1Password; nothing else depends on it. A failed download therefore WARNs and continues
# rather than failing the whole base build.
RUN if curl -sSf https://downloads.1password.com/linux/keys/1password.asc | \
        gpg --dearmor --output /usr/share/keyrings/1password-archive-keyring.gpg && \
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/$(dpkg --print-architecture) stable main" | \
        tee /etc/apt/sources.list.d/1password.list && \
      apt-get update && apt-get install -y 1password 1password-cli; then \
        echo "1Password CLI + desktop app installed"; \
    else \
        echo "WARNING: 1Password install failed (downloads.1password.com blocked/unreachable?); continuing without op-ssh-sign — 1Password-based SSH commit signing will be unavailable in this image" >&2; \
        rm -f /etc/apt/sources.list.d/1password.list /usr/share/keyrings/1password-archive-keyring.gpg; \
    fi; \
    rm -rf /var/lib/apt/lists/*

# Fixed container user `harnessed` with home /home/harnessed (rename the stock ubuntu user,
# keeping UID 1000 so `--userns=keep-id` maps the host user cleanly).
ARG USERNAME=harnessed
RUN usermod -l ${USERNAME} ubuntu && \
    groupmod -n ${USERNAME} ubuntu && \
    usermod -d /home/${USERNAME} ${USERNAME} && \
    mkdir -p /home/${USERNAME} && \
    cp -an /home/ubuntu/. /home/${USERNAME}/ 2>/dev/null || true && \
    rm -rf /home/ubuntu && \
    # Pre-create ~/.ssh with strict 0700 perms so the launcher's per-file credential mounts
    # (config / known_hosts / *.pub / opt-in keys) land in a correctly-owned dir — otherwise podman
    # auto-creates the mount-point root-owned and ssh refuses "Bad owner or permissions on ~/.ssh".
    mkdir -p /home/${USERNAME}/.ssh && chmod 700 /home/${USERNAME}/.ssh && \
    chown -R ${USERNAME}:${USERNAME} /home/${USERNAME}

USER ${USERNAME}
WORKDIR /home/${USERNAME}
ENV HOME=/home/${USERNAME}

USER root
# Optional corporate proxy CA: injected as a build secret when present at
# $XDG_CONFIG_HOME/harnessed/corp-proxy-ca.crt (set once via `harnessed build --corp-proxy-ca-crt`).
# required=false: absent secret → mount not present → no-op; no file staged in the build context.
RUN --mount=type=secret,id=corp_proxy_ca,dst=/tmp/corp-proxy-ca.crt,required=false \
    if [ -s /tmp/corp-proxy-ca.crt ]; then \
        cp /tmp/corp-proxy-ca.crt /usr/local/share/ca-certificates/corp-proxy-ca.crt && \
        chmod 0644 /usr/local/share/ca-certificates/corp-proxy-ca.crt && \
        update-ca-certificates; \
    fi
USER ${USERNAME}
# Pre-create every build cache-mount target AND its parents, owned by ${USERNAME} (bd
# harnessed-1t4.2). Not cosmetic: podman creates a missing mount point and its parent dirs as ROOT.
# Seen for real while a pnpm-store mount was still in play: the runtime created a root-owned
# /home/${USERNAME}/.local/share, and every later `mise install` died with "create_dir_all:
# ~/.local/share/mise/installs/…: Permission denied". The store mount is gone (see emit._BUILD_CACHES
# — pnpm symlinks globals INTO the store, so caching it ships dangling links), but the ownership rule
# holds for every mount target that remains.
RUN mkdir -p /home/${USERNAME}/.cache/mise \
             /home/${USERNAME}/.cache/pnpm \
             /home/${USERNAME}/.cache/uv \
             /home/${USERNAME}/.local/share/mise

# mise (runtime manager) + shims on PATH
RUN curl -fsSL https://mise.run | bash
ENV PATH="/home/${USERNAME}/.local/share/mise/shims:/home/${USERNAME}/.local/bin:${PATH}"
# mise's global config lives at $XDG_CONFIG_HOME/mise/config.toml by default — i.e. under ~/.config,
# which is OUTSIDE the ~/.local volume that bd harnessed-8px.21.3 persists `tools:` into. `mise use
# -g` would then record its versions in an ephemeral container: the NEXT step sees the shim on PATH
# but no version bound to it, and dies with "No version is set for shim: <tool>". Found by running
# the real executor end-to-end; a unit test cannot see it because the failure is cross-container.
#
# Relocated INTO ~/.local/share/mise so the versions travel with the installs they describe, in one
# volume. Set as an image ENV rather than per-invocation so the agent's own shims resolve too — the
# running agent needs the same binding the installer wrote.
ENV MISE_GLOBAL_CONFIG_FILE="/home/${USERNAME}/.local/share/mise/config.toml"

# pnpm's global bin dir is $PNPM_HOME/bin; it must be on PATH or `pnpm add -g` fails ("not in PATH")
# and the installed binary (e.g. snyk, used by the supply-chain scan layer) is unreachable at runtime.
ENV PNPM_HOME="/home/${USERNAME}/.local/share/pnpm"
ENV PATH="${PNPM_HOME}/bin:${PATH}"

# Managed pnpm supply-chain config (Phase 3 / BLD-01). Must be in place before
# mise's npm: backend resolves globals (RESEARCH Pitfall 5). Root COPY + chown
# mirrors the extra-tools.txt dance below.
USER root
COPY catalog/base/pnpm/config.yaml /tmp/pnpm-config.yaml
RUN mkdir -p /home/${USERNAME}/.config/pnpm && \
    mv /tmp/pnpm-config.yaml /home/${USERNAME}/.config/pnpm/config.yaml && \
    chown -R ${USERNAME}:${USERNAME} /home/${USERNAME}/.config
USER ${USERNAME}

# Core runtimes — no harness CLIs in base (IMG-01 complete). Harness CLIs (claude, omp, codex,
# opencode, antigravity) are each installed in their own harness image FROM this base.
# Note: opencode-ai removed — non-functional in base. npm.package_manager=pnpm routes npm: tools
# through pnpm so the managed policy governs them (RESEARCH Pitfall 5); set BEFORE `mise use -g`.
# pnpm@11 (not @latest) so the v11 supply-chain defaults are in effect (Node ≥ 20 required; node@22 LTS).
RUN --mount=type=cache,target=/home/harnessed/.cache/mise,id=harnessed-mise,uid=1000,gid=1000,sharing=locked \
    --mount=type=cache,target=/home/harnessed/.cache/pnpm,id=harnessed-pnpm-meta,uid=1000,gid=1000,sharing=shared \
    --mount=type=cache,target=/home/harnessed/.cache/uv,id=harnessed-uv,uid=1000,gid=1000,sharing=shared \
    mise settings set experimental true && \
    mise settings set npm.package_manager pnpm && \
    mise use -g \
        node@22 \
        pnpm@11 \
        python@3.12 \
        bun@1.2 \
        rust@1.87 \
        go@1.24 \
        fd \
        ripgrep \
        gh@2.96.0 && \
    mise install && \
    mise trust "$MISE_GLOBAL_CONFIG_FILE"

# RESTORE THE OWNERSHIP THE CACHE MOUNT ABOVE TOOK. A `--mount=type=cache` leaves the PARENT
# directories of its target owned by root in the committed layer — here /home/${USERNAME} and
# /home/${USERNAME}/.cache. Layers that only append to files they already own keep working, so the
# damage stays invisible until something CREATES a new dot-directory in $HOME: the very next layer
# (`npm install -g`, which makes ~/.npm) died with EACCES, and much later Claude Code's installer
# died on `mkdir -p "$HOME/.claude/downloads"`. Both were the same defect.
#
# Dated observation, not a standing claim about podman: this file built green on GitHub's runner
# under podman 4.9.3 and went red the same day the runner moved to podman 5.8.4 (2026-08-13), with
# no change here; a fresh --no-cache build under podman 6.0.2 does not reproduce it. So the restore
# is written to be harmless where it is unnecessary rather than conditional on a version.
#
# NOT `chown -R`: by this point $HOME holds the mise/pnpm/rust toolchains, and a recursive chown
# rewrites every one of those files into a new layer (the pre-existing `chown -R` below predates
# this understanding). Only the two mount parents are wrong, and they are directories.
USER root
RUN chown ${USERNAME}:${USERNAME} /home/${USERNAME} /home/${USERNAME}/.cache
USER ${USERNAME}

# Pin the node-bundled npm to a patched release. node@22 ships npm@10.9.8, whose transitive deps
# (brace-expansion, pacote) carry HIGH-severity CVEs the supply-chain scan flags. A self-upgrade is
# the only way to move what the scan sees under lib/node_modules — pnpm has no equivalent. Pinned,
# not @latest (the build rejects floating pins).
#
# DO NOT bump this expecting the remaining brace-expansion HIGHs to clear — that lever is spent.
# Verified 2026-08-22: 11.18.0, 11.19.0, and 12.0.2 (`latest`) all bundle brace-expansion 5.0.7,
# and the fix is 5.0.9. Those two advisories are acknowledged by id in catalog/base/harnessed-scan
# (ACKNOWLEDGED); bump this pin for a NEW finding, and drop the entries there once npm ships 5.0.9.
RUN npm install -g npm@11.18.0

# Delete corepack. It ships inside the node@22 release tarball and harnessed never uses it — pnpm
# comes from mise (`pnpm@11` above), not `corepack prepare`, and nothing in catalog/ or
# src/harnessed/ invokes it. Left in place it is dead weight that the in-image supply-chain scan
# flags on every build. Deleting beats acknowledging: the findings go away because the code does.
# Drop the mise shim too, or `corepack` stays on PATH resolving to a file that is gone.
#
# FAIL CLOSED. `mise where` writes its errors to stderr and nothing to stdout, so interpolating it
# straight into a path would leave an absolute one that does not exist here — and `rm -rf` on a
# missing path returns 0. The layer would go green while corepack survived, which is exactly the
# finding this was added to remove. So: resolve once, refuse an empty or absent answer, and prove
# the removal worked rather than assuming it did.
RUN NODE_DIR="$(mise where node@22)" && \
    [ -n "$NODE_DIR" ] && [ -d "$NODE_DIR" ] && \
    rm -rf "$NODE_DIR/lib/node_modules/corepack" \
           "$NODE_DIR/bin/corepack" \
           "$HOME/.local/share/mise/shims/corepack" && \
    mise reshim && \
    ! command -v corepack

# Extra user-specified tools. Edit ~/.config/harnessed/extra-tools.txt to add more (seeded from
# catalog/base/extra-tools.default.txt); the base build stages that into catalog/base/extra-tools.txt.
# Switch to root for COPY to avoid Podman overlay layer corrupting home dir ownership.
USER root
COPY catalog/base/extra-tools.txt /tmp/extra-tools.txt
RUN chown -R ${USERNAME}:${USERNAME} /home/${USERNAME}
USER ${USERNAME}
RUN --mount=type=cache,target=/home/harnessed/.cache/mise,id=harnessed-mise,uid=1000,gid=1000,sharing=locked \
    --mount=type=cache,target=/home/harnessed/.cache/pnpm,id=harnessed-pnpm-meta,uid=1000,gid=1000,sharing=shared \
    --mount=type=cache,target=/home/harnessed/.cache/uv,id=harnessed-uv,uid=1000,gid=1000,sharing=shared \
    grep -v '^\s*#' /tmp/extra-tools.txt | grep -v '^\s*$' | awk '{print $1}' | \
    xargs -r mise use -g && mise install
# Same restore as above, for the cache mount immediately preceding it.
USER root
RUN chown ${USERNAME}:${USERNAME} /home/${USERNAME} /home/${USERNAME}/.cache
USER ${USERNAME}

# Supply-chain scanners (BLD-02) + the in-image scan script, baked once and invoked as the final
# layer of every assembled stack image (emit.write_derived_dockerfile). osv-scanner + pip-audit are
# credential-free and run on every build. snyk + socket are token-gated: they stay silent during the
# (deliberately credential-free) build and only run under `harnessed rescan`, which resolves the
# tokens on the HOST from ~/.config/harnessed/.env{,.schema} and injects them as container env.
# All four are baked here so rescan needs no network install. uv backs pip-audit (uvx policy).
RUN --mount=type=cache,target=/home/harnessed/.cache/mise,id=harnessed-mise,uid=1000,gid=1000,sharing=locked \
    --mount=type=cache,target=/home/harnessed/.cache/pnpm,id=harnessed-pnpm-meta,uid=1000,gid=1000,sharing=shared \
    --mount=type=cache,target=/home/harnessed/.cache/uv,id=harnessed-uv,uid=1000,gid=1000,sharing=shared \
    mise use -g uv osv-scanner && mise install \
    && uv tool install pip-audit \
    && mkdir -p "$PNPM_HOME/bin" && pnpm add -g snyk socket@1.1.143
# Same restore as above, for the cache mount immediately preceding it.
USER root
RUN chown ${USERNAME}:${USERNAME} /home/${USERNAME} /home/${USERNAME}/.cache
COPY catalog/base/harnessed-scan /usr/local/bin/harnessed-scan
COPY catalog/base/harnessed-start /usr/local/bin/harnessed-start
COPY catalog/base/op /usr/local/bin/op
RUN chmod 0755 /usr/local/bin/harnessed-scan /usr/local/bin/harnessed-start /usr/local/bin/op
# /usr/local/bin precedes /usr/bin on PATH, so the shim wins. Drop it when the best-effort
# 1Password install above did not land — otherwise the shim would turn "op is not installed"
# (a case callers already handle via `command -v op`) into an op that exists but always fails.
RUN [ -x /usr/bin/op ] || rm -f /usr/local/bin/op
USER ${USERNAME}

# hatago MCP hub (in-container MCP bus, hatago-consolidation.md) + time server, baked once.
# Every harness image inherits these — no separate hatago image. pnpm add -g is the project
# convention for npm globals (CLAUDE.md); uv tool install for the python server.
#
# @drmikecrowe/… is the maintained FORK (bd harnessed-1t4.1). Upstream @himorishige stopped at
# 0.0.16 (2025-09-14); the fork carries per-server tool filtering, which a stack used to obtain by
# cloning and BUILDING the branch inside its derived image — 410 packages resolved per build, on top
# of this layer. Same bin map ({hatago, hatago-mcp-hub} → dist/node/cli.js), so nothing that invokes
# the binary by name changes.
RUN --mount=type=cache,target=/home/harnessed/.cache/mise,id=harnessed-mise,uid=1000,gid=1000,sharing=locked \
    --mount=type=cache,target=/home/harnessed/.cache/pnpm,id=harnessed-pnpm-meta,uid=1000,gid=1000,sharing=shared \
    --mount=type=cache,target=/home/harnessed/.cache/uv,id=harnessed-uv,uid=1000,gid=1000,sharing=shared \
    pnpm add -g "@drmikecrowe/hatago-mcp-hub@0.1.2"
# Same restore as above, for the cache mount immediately preceding it. This is the last one, so it
# is also what the shipped image's $HOME ownership comes from.
USER root
RUN chown ${USERNAME}:${USERNAME} /home/${USERNAME} /home/${USERNAME}/.cache
USER ${USERNAME}

# Interactive shell config
RUN echo 'PS1="\[\033[01;32m\][harnessed]\[\033[00m\] \[\033[01;34m\]\w\[\033[00m\]\$ "' >> /home/${USERNAME}/.bashrc && \
    echo 'eval "$(mise activate bash)"' >> /home/${USERNAME}/.bashrc && \
    echo 'mise trust -a 2>/dev/null' >> /home/${USERNAME}/.bashrc

# profile.d runs for login shells too (bash -lc, as used by recipe init.run), unlike .bashrc which
# only sources for interactive shells. Recipes whose tools resolve through mise shims need trust
# established before init.run executes, or mise aborts on the untrusted mise.toml.
USER root
RUN echo 'mise trust -a 2>/dev/null || true' > /etc/profile.d/mise-trust.sh && \
    chmod 0644 /etc/profile.d/mise-trust.sh
USER ${USERNAME}

# Rootless podman on macOS maps host UIDs through the VM, so git sees mounted project directories as
# "dubious ownership" and refuses to run — breaking mise templates that shell out to git. Trust all
# directories globally; this container is single-user and already isolated.
# Must use --system (/etc/gitconfig), not --global (~/.gitconfig): the launcher mounts the host's
# ~/.gitconfig into the container read-only, so any write attempt fails with "Device or resource busy".
USER root
RUN git config --system --add safe.directory '*'

# THE HOME DIRECTORY MUST BE OWNED BY ${USERNAME} IN THE COMMITTED IMAGE, and the last three root
# blocks above did not restore that the way the extra-tools COPY block does (line ~150). Every
# derived image starts by writing into $HOME — the claude installer's first act is
# `mkdir ~/.claude` — so a home directory this image hands over root-owned fails the CHILD build,
# with an error that names the child's installer and gives no hint that the base is at fault.
#
# NOT recursive, deliberately: only the directory's own ownership is at stake, and a `chown -R` over
# a home holding mise, pnpm and uv trees would copy the whole lot into a new layer for nothing.
#
# HONEST ABOUT WHAT THIS IS. It hardens against a fault observed ONCE and not reproduced: live.yml
# run 31699857493 failed at `mkdir: cannot create directory '/home/harnessed/.claude': Permission
# denied`, while run 31708908139 built the identical Dockerfile 20 minutes later and passed. The
# two logs agree step for step through all 48 base steps, so the trigger is environmental — the same
# class this file already cites twice ("Podman overlay layer corrupting home dir ownership" above,
# and the cache-mount parent pre-creation at line ~82). This line makes the invariant explicit
# instead of inherited, which is cheap; it is not a proven fix, because the cause is not proven.
RUN chown ${USERNAME}:${USERNAME} /home/${USERNAME}
USER ${USERNAME}

# FAIL IN THE BASE BUILD, WHERE THE FAULT IS, rather than in whichever child image happens to touch
# $HOME first. This converts "the claude installer cannot mkdir" into "harnessed-base produced an
# unusable home directory", which is the difference between debugging the wrong image and the right
# one. Costs one layer with no content.
#
# PERFORMS THE OPERATION rather than testing a proxy for it. `test -w` checks the write bit only,
# and creating an entry in a directory needs write AND SEARCH — so a home left `d-w-------` passes
# `test -w` and still fails the `mkdir ~/.claude` that the claude image opens with. A gate that
# green-lights the exact failure it was added to catch is worse than no gate, because it also
# certifies. Raised by CodeRabbit on PR #364. The probe is the real thing: create a directory as
# ${USERNAME}, in $HOME, and remove it — leaving no content behind either way.
#
# ~/.cache IS PROBED TOO, and not for symmetry: it is the directory that actually shipped broken.
# On live.yml run 62 $HOME alone passed this gate while /home/${USERNAME}/.cache was still
# root-owned, and the build died one image later on the Claude installer's `mkdir ~/.cache/claude`.
# A gate that clears the exact failure it exists to catch is the "worse than no gate" case named
# above, so the probe now covers every directory the restores repair. It probes rather than creates:
# ~/.cache is pre-created far above, so a failure here is a real defect, not a missing directory.
RUN for probe_dir in "/home/${USERNAME}" "/home/${USERNAME}/.cache"; do \
      probe="$probe_dir/.harnessed-home-probe"; \
      mkdir "$probe" && rmdir "$probe" || { \
        echo "harnessed-base: ${USERNAME} cannot create a directory in $probe_dir — every derived image will fail on its first write there" >&2; \
        ls -ld "$probe_dir" >&2; \
        exit 1; \
      }; \
    done

CMD ["/bin/bash"]
