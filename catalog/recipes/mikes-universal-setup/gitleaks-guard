#!/usr/bin/env bash
# gitleaks-guard — PreToolUse gate: refuse `git commit` / `git push` when gitleaks finds a secret.
#
# This is NOT a git hook. It is the harness's own PreToolUse hook, so the agent cannot get past it
# with `--no-verify` (which only bypasses git's hooks) — the Bash tool call itself never runs.
# A git hook still belongs on the HOST for the user's own commits; see the recipe's `setup:` notice.
#
# Contract (Claude Code PreToolUse, and omp via omp-claude-hooks-bridge): read the event JSON on
# stdin, print a decision on stdout, exit 0. `permissionDecision: deny` blocks the call. The bridge
# drops a hook's additionalContext but DOES honor permissionDecision — so this gate works on omp too.
set -uo pipefail

deny() {
  jq -n --arg r "$1" '{hookSpecificOutput: {hookEventName: "PreToolUse",
                                            permissionDecision: "deny",
                                            permissionDecisionReason: $r}}' 2>/dev/null ||
    # Even jq-less, still fail closed: hand-roll the JSON rather than allow the call.
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":%s}}\n' \
      "\"${1//\"/\\\"}\""
  exit 0
}

payload=$(cat)

# jq comes from the base's mise extra-tools layer, but that list is user-editable — so it is not
# guaranteed. A gate that cannot read its input must not wave the commit through.
command -v jq >/dev/null || deny \
  "gitleaks-guard cannot run: jq is not on PATH, so the hook payload cannot be parsed.
Add jq back to ~/.config/harnessed/extra-tools.txt and rebuild, or remove the gitleaks-guard
PreToolUse hook from the mikes-universal-setup recipe. Refusing to allow an unscanned commit."

tool=$(jq -r '.tool_name // empty' <<<"$payload")
[[ $tool == "Bash" ]] || exit 0

cmd=$(jq -r '.tool_input.command // empty' <<<"$payload")
[[ -n $cmd ]] || exit 0

# Only guard the two commands that create or publish history.
#
# Deliberately loose: `git` anywhere as a word, then `commit`/`push` anywhere as a word. Trying to
# parse git's actual grammar is a trap — an earlier pass anchored the subcommand right after the
# flags and silently let `git -C /tmp push origin main` through, because `-C /tmp` is two tokens.
# Over-matching (`git log --grep commit`) is harmless: it costs one extra scan and can only ever
# DENY if a real secret is genuinely staged, which you want to hear about regardless. Under-matching
# leaks. So: fail closed.
if [[ $cmd =~ (^|[^[:alnum:]_-])git([[:space:]]|$) ]]; then
  if   [[ $cmd =~ (^|[[:space:]])commit([[:space:]]|$) ]]; then action=commit
  elif [[ $cmd =~ (^|[[:space:]])push([[:space:]]|$)   ]]; then action=push
  else exit 0
  fi
else
  exit 0
fi

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0  # not a repo — nothing to scan

# Same fail-closed stance: `tools: gitleaks@8.30.1` should have put this on PATH. If it did not,
# the gate is not working, and the honest response is to say so and block — not to pretend.
command -v gitleaks >/dev/null || deny \
  "gitleaks-guard cannot run: gitleaks is not on PATH, so the ${action} could not be scanned.
Refusing to allow it unscanned. (Expected from the recipe's pinned \`tools: gitleaks@8.30.1\`.)"

# --exit-code 2 for leaks, so a LEAK is distinguishable from gitleaks ITSELF failing (bad flag,
# unreadable config, …) — which also exits non-zero. Conflating the two is how a gate becomes a
# wall: an early version passed `--report-path -` with no format, gitleaks died "Unknown report
# format", and every clean commit was denied as if it held a secret. Both cases still block, but
# they must SAY which, or the fix is unfindable and the gate gets ripped out.
scan_args=(--no-banner --redact --verbose --exit-code 2)

# NOTE: `deny` must be called from THIS shell, never inside a $(…). An earlier version wrapped the
# scan in a helper and called deny from within the command substitution: the JSON was captured into
# the variable instead of printed, and `exit 0` only ended the subshell — so the guard FAILED OPEN
# on exactly the error path that was supposed to fail closed. Only gitleaks runs in the subshell.
if [[ $action == commit ]]; then
  # The staged tree is exactly what the commit would contain — the true prevention point.
  out=$(gitleaks git --staged "${scan_args[@]}" 2>&1); rc=$?
  case $rc in
    0) exit 0 ;;
    2) deny "gitleaks found a secret in the STAGED changes. The commit was blocked.

$out

Remove the secret (do NOT just unstage it — if it already reached history, it must be ROTATED).
A false positive can be annotated with a \`gitleaks:allow\` comment or added to .gitleaksignore." ;;
    *) deny "gitleaks-guard could not scan the staged changes (gitleaks exited ${rc}, which is not a
leak result). Refusing to allow an unscanned commit — fix the guard, do not ignore this.

$out" ;;
  esac
fi

# push: scan the commits that would actually leave the machine. Commits made in this pod already
# passed the commit gate, but commits made on the HOST (no gitleaks there) did not — and push is
# the irreversible one.
if range=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
  log_opts="$range..HEAD"
elif git rev-parse --verify --quiet origin/HEAD >/dev/null; then
  log_opts="origin/HEAD..HEAD"   # new branch, never pushed: everything not on the default branch
else
  exit 0  # no remote to compare against — nothing meaningful to scan; let it through
fi

git log --oneline -1 "$log_opts" >/dev/null 2>&1 || exit 0  # empty/invalid range — nothing to push

out=$(gitleaks git --log-opts="$log_opts" "${scan_args[@]}" 2>&1); rc=$?
case $rc in
  0) exit 0 ;;
  2) deny "gitleaks found a secret in the commits this push would publish ($log_opts). The push was
blocked.

$out

Pushing makes this public and cached beyond your control. The secret must be ROTATED and the history
rewritten — unstaging it or adding a follow-up commit is not enough." ;;
  *) deny "gitleaks-guard could not scan the commits this push would publish (gitleaks exited ${rc},
which is not a leak result). Refusing to allow an unscanned push — fix the guard, do not ignore this.

$out" ;;
esac
