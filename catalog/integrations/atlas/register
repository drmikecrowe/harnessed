#!/bin/sh
# Add this stack's ACP launcher to Atlas's external agents: `--register-atlas-only` (GH-569).
# harnessed runs this with the integration contract's HARNESSED_* variables set.
# `harnessed.jsonc` keeps every other entry's bytes, and creates the file when it is missing.
set -eu
if [ -z "$HARNESSED_ACP_LAUNCHER" ]; then
    acp=$("$HARNESSED_PYTHON" -c 'from harnessed.attachcmd import _ACP_HARNESSES; print(", ".join(_ACP_HARNESSES))')
    echo "error: Atlas needs an ACP harness; $HARNESSED_HARNESS has no ACP mode (ACP harnesses: $acp)" >&2
    exit 1
fi
if [ "$HARNESSED_BACKEND" = container ]; then
    key="harnessed $HARNESSED_HARNESS ($HARNESSED_STACK, container)"
else
    key="harnessed $HARNESSED_HARNESS ($HARNESSED_STACK)"
fi
file="${XDG_DATA_HOME:-$HOME/.local/share}/dev.atlas.ide/external-agents/installed.json"
command=$("$HARNESSED_PYTHON" -c 'import json, sys; print(json.dumps(sys.argv[1]))' "$HARNESSED_ACP_LAUNCHER")
jsonc() { "$HARNESSED_PYTHON" -m harnessed.jsonc "$@"; }
jsonc setdefault "$file" "$key" "{\"type\": \"custom\", \"command\": $command, \"args\": []}"
jsonc set "$file" "$key" type '"custom"'
jsonc set "$file" "$key" command "$command"
echo "Registered Atlas agent '$key' in $file"
