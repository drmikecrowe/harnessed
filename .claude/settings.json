{
  "fileSuggestion": {
    "command": ".claude/file-suggestion.sh",
    "type": "command"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push:*)",
            "command": ".claude/hooks/branch-vcs-gate.sh"
          },
          {
            "type": "command",
            "if": "Bash(gh pr create:*)",
            "command": ".claude/hooks/branch-vcs-gate.sh"
          }
        ]
      }
    ]
  }
}
