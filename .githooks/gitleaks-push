#!/usr/bin/env sh
# Scan the commits a push would publish. Wired as a `repo: local` pre-push hook — see
# .pre-commit-config.yaml, and CONTRIBUTING.md "Secret gate".
#
# Why this exists at all: gitleaks' own pre-commit hook scans only the STAGED tree, so it cannot see
# a secret that entered history another way — `git commit --no-verify`, a rebase or cherry-pick, or
# a clone from a machine with no hooks. Push is the irreversible step; once a secret lands on a
# remote it is cached, forked and mirrored beyond recall.
#
# pre-commit hands a pre-push hook the exact range: PRE_COMMIT_FROM_REF (what the remote has) and
# PRE_COMMIT_TO_REF (what we are sending). It also consumes git's stdin ref list itself, so this
# script never has to — which matters, because the beads pre-push hook (chained by pre-commit as
# pre-push.legacy) reads that same stdin, and stdin can only be consumed once.
#
# Fails CLOSED: a missing or erroring gitleaks refuses the push rather than leaving it unscanned.
# Deliberate override:  SKIP=gitleaks-push git push …   (pre-commit's own skip mechanism)
set -u

if ! command -v gitleaks >/dev/null 2>&1; then
  echo >&2 "gitleaks: not on PATH — refusing to push unscanned."
  echo >&2 "  install:  mise use -g gitleaks@8.30.1"
  echo >&2 "  override: SKIP=gitleaks-push git push …"
  exit 1
fi

from=${PRE_COMMIT_FROM_REF:-}
to=${PRE_COMMIT_TO_REF:-HEAD}

# A brand-new branch has no remote counterpart: FROM_REF is the all-zero sha (or empty). Nothing to
# diff against, so scan every commit on this branch that is not already on the default branch.
case "$from" in
  ''|0000000000000000000000000000000000000000)
    if git rev-parse --verify --quiet origin/HEAD >/dev/null 2>&1; then
      range="origin/HEAD..${to}"
    else
      exit 0   # no remote to compare against — nothing meaningful to scan
    fi
    ;;
  *) range="${from}..${to}" ;;
esac

git rev-list --quiet -1 "$range" 2>/dev/null || exit 0   # empty range — nothing being pushed

# --exit-code 2 so a real LEAK (2) is distinguishable from gitleaks itself failing (any other
# non-zero: bad flag, unreadable config). Both block, but they must say WHICH — a gate whose failure
# mode is unreadable gets disabled.
gitleaks git --log-opts="$range" --no-banner --redact --verbose --exit-code 2
rc=$?

if [ $rc -eq 2 ]; then
  echo >&2 ""
  echo >&2 "gitleaks: SECRET DETECTED in the commits this push would publish ($range)."
  echo >&2 "  ROTATE the credential and rewrite the history — deleting the line in a follow-up"
  echo >&2 "  commit does NOT remove it from history."
  echo >&2 "  Override: SKIP=gitleaks-push git push …"
  exit 1
elif [ $rc -ne 0 ]; then
  echo >&2 ""
  echo >&2 "gitleaks: scan FAILED (exit $rc — not a leak result). Refusing to push unscanned."
  echo >&2 "  Override: SKIP=gitleaks-push git push …"
  exit 1
fi

exit 0
