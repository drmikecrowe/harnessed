.claude/*
.npm
pip
.local

extra-tools.txt

!.claude/.gitkeep
!.claude/settings.json
!.claude/file-suggestion.sh
# The hooks dir must be un-ignored BEFORE its contents: `.claude/*` excludes the
# directory itself, and git never descends into an excluded directory, so a bare
# `!.claude/hooks/*.sh` would match nothing. settings.json references these by path,
# so an untracked hook makes the committed settings point at a missing script.
!.claude/hooks/
!.claude/hooks/*.sh

.dockerignore

# Generated stack profiles — output of `harnessed build`, regenerated on every build.
# stacks/<name>/stack.yaml is the authored source of truth; profiles/ is the mount artifact.
/profiles/

# DX symlinks: catalog-local/<kind> → ~/.config/harnessed/catalog/<kind> (created by `harnessed build`).
# Deliberately OUTSIDE catalog/: catalog/ is shipped inside the wheel and setuptools follows symlinks,
# so a link to the user's private overlay parked in there would be published. See paths.local_links_dir.
/catalog-local/

# Stale pre-move location (catalog/<kind>.local). `harnessed build` unlinks these on first run; the
# pattern stays so an un-migrated checkout doesn't show them as untracked in the meantime.
catalog/*.local

# docs/ is an unpinned live clone of the project's GitHub wiki (bootstrapped by
# `harnessed build`, see _ensure_docs_wiki_clone in launcher.py). Not a submodule --
# no pinned commit, no pointer-bump PRs. Pull it yourself: git -C docs pull.
/docs/

# Throwaway fixture profiles emitted by `harnessed build <fixture-stack> --root tools/test-fixtures`.
tools/test-fixtures/profiles/

# Stray SSH debug log (not part of the project)
ssh-verbose.log

# Python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.venv/
/build/
/dist/

# Leftovers from beads, which was RETIRED 2026-08-08. These entries deliberately OUTLIVE the
# feature: an existing checkout can still hold this state on disk, and the `.beads/.gitignore` that
# used to cover it was deleted along with everything else. Without these lines a `git add .` in such
# a checkout would commit `.beads-credential-key` (the federation peer-auth key) or `.beads/.env`
# (a Dolt connection string). Removing a feature must never un-ignore its credentials. Drop these
# only once no checkout in the wild still carries a `.beads/`.
.beads/
.beads-credential-key
.dolt/
*.db
mise.local.toml

# Gauntlet artifacts (bd harnessed-rv2 declared these tools; these are what they leave behind).
.coverage
coverage.xml
.hypothesis/
mutants/
